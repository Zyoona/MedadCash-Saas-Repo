# ── Dependencies (NOT committed) ─────────────────────────────
# node_modules is intentionally untracked. It duplicated the workspace through
# npm junctions (node_modules/@medad/* -> apps/*, packages/*) and carried files
# that are regenerated on every machine (node_modules/.prisma/client,
# node_modules/.package-lock.json). That caused constant Git conflicts.
# Restore it on any machine with:  npm ci   (offline via _tools/npm-cache)
node_modules/

# IMPORTANT: never use unanchored build-output patterns here (`dist/`, `build/`, `out/`).
# Without a leading/middle slash they match at ANY depth, which also strips those
# folders from inside vendored dependencies. Keep them anchored to workspace projects.
*.local

# .env holds local dev secrets (port 5433) — keep ignored, .env.example is the template.
.env
!.env.example

# Generated Prisma client / per-machine caches
.prisma/
**/.prisma/
**/.cache/
**/.vite/

# ── Local database files — NEVER pushed ─────────────────────
# `prisma/*.db` alone was anchored to the repo root, so a DB created next to the
# real schema (apps/api/prisma/*.db) was NOT ignored. `**/prisma/*.db` covers it.
**/prisma/*.db
**/prisma/*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal

# Build outputs — anchored to workspace projects only (NOT node_modules)
/apps/*/dist/
/packages/*/dist/
/build/
/out/

# Local tooling output — keep node binaries, ignore caches/logs/data.
/_tools/npm-cache/
# The whole embedded Postgres cluster (data pages + WAL + pid + log) is
# per-machine. Ignoring the folder — not just data/ — guarantees no DB file can
# ever be staged or pushed, which is what caused cross-device merge conflicts.
/_tools/pgsql/
/_tools/backups/
/_tools/uploads/
/_tools/logs/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
